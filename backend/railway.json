{
  "root": "backend",
  "build": {
    "builder": "nixpacks",
    "nixpacks": {
      "plan": {
        "packages": [
          "php83",
          "php83Extensions.iconv",
          "php83Extensions.mbstring",
          "php83Extensions.mongodb",
          "php83Packages.composer"
        ],
        "commands": [
          "echo 'Forçage de l'installation des extensions PHP'",
          "php -m | grep -E 'iconv|mbstring|mongodb' || exit 1"
        ]
      }
    }
  },
  "start": "php -S 0.0.0.0:$PORT -t backend"
}
