{
  "root": "backend",
  "build": {
    "builder": "nixpacks",
    "nixpacks": {
      "plan": {
        "packages": ["php", "php-cgi", "php-session"],
        "commands": [
          "echo '✅ Création du fichier custom.ini pour activer session'",
          "echo 'extension=session.so' > /app/custom.ini",
          "echo 'session.save_handler = files' >> /app/custom.ini",
          "echo 'session.save_path = \"/tmp\"' >> /app/custom.ini"
        ]
      }
    }
  },
  "env": {
    "PHP_INI_SCAN_DIR": "/app"
  },
  "start": "php -S 0.0.0.0:$PORT -t backend"
}
